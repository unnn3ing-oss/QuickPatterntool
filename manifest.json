{
  "manifest_version": 3,
  "name": "圖片套版產生器",
  "version": "2.10",
  "description": "TVBS 新聞／娛樂圖卡套版：貼上文章網址，自動帶入標題與首圖，並複製圖文格式。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "圖片套版產生器",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "clipboardWrite", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
